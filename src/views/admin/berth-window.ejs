<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · MPC Ops</title>
  <link rel="stylesheet" href="/css/berth-window.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="admin-page">
  <div class="admin-shell">
    <%- include('../partials/admin-sidebar', { activePage }) %>

    <div class="admin-workspace">
      <%- include('../partials/admin-topbar', {
        pageTitle: 'Berth Window',
        eyebrow: 'CÔNG CỤ KHAI THÁC',
        weekNavigation: true,
        user
      }) %>

      <main class="admin-content admin-content-wide">
        <div class="tool-context">
          <div class="tool-breadcrumb">
            <a href="/admin">Dashboard</a><span>/</span><strong>Berth Window</strong>
          </div>
          <div class="tool-context-actions">
            <p id="quaySummary">Đang tải cấu hình cầu bến…</p>
          </div>
        </div>
        <div class="wrap tool-wrap">
    <div class="view-tabs" role="tablist" aria-label="Chế độ hiển thị Berth Window">
      <button type="button" class="view-tab is-active" id="timelineTab" role="tab" aria-selected="true" aria-controls="timelineView">Biểu đồ không gian - thời gian</button>
      <button type="button" class="view-tab" id="berth2dTab" role="tab" aria-selected="false" aria-controls="berth2dView">Sơ đồ cầu bến 2D</button>
    </div>

    <div class="panel" id="timelineView" role="tabpanel" aria-labelledby="timelineTab">
      <div class="panel-head">
        <h2>Biểu đồ không gian - thời gian</h2>
        <div class="tools">
          <label class="chk"><input type="checkbox" id="showWindow" checked> Cửa sổ hợp đồng</label>
          <label class="chk"><input type="checkbox" id="showTide" checked> Khung thủy triều</label>
          <label class="chk">Tuyến
            <select id="filterSvc"><option value="">Tất cả</option></select>
          </label>
        </div>
      </div>
      <div class="chartrow">
        <div class="axis"><svg id="axisSvg" role="img" aria-label="Trục chiều dài cầu bến"></svg></div>
        <div class="scroller" id="scroller"><svg id="chartSvg" role="img" aria-label="Biểu đồ cửa sổ cầu bến theo thời gian"></svg></div>
      </div>
      <div class="legend">
        <span><i class="sw sw-window"></i> Lượt tàu theo cửa sổ</span>
        <span><i class="sw sw-adhoc"></i> Tàu vãng lai</span>
        <span><i class="sw sw-conflict"></i> Xung đột vị trí</span>
        <span><i class="sw sw-commitment"></i> Cửa sổ cam kết</span>
        <span><i class="sw sw-tide"></i> Khung triều cho tàu mớn sâu</span>
      </div>
    </div>

    <div class="panel berth-plan" id="berth2dView" role="tabpanel" aria-labelledby="berth2dTab" hidden>
      <div class="panel-head berth-plan-head">
        <div>
          <h2>Sơ đồ cầu bến 2D</h2>
          <p>Tàu dự kiến hiện diện tại cầu ở thời điểm được chọn.</p>
        </div>
        <div class="berth-plan-controls">
          <button type="button" class="btn" id="berth2dPlay" aria-pressed="false">Phát ▶</button>
        </div>
      </div>
      <div class="berth-plan-time">
        <div class="berth-plan-range">
          <input id="berth2dRange" type="range" min="0" max="10065" step="1" aria-label="Thanh thời gian toàn tuần">
          <div class="berth-plan-days" aria-hidden="true">
            <span>T2</span><span>T3</span><span>T4</span><span>T5</span><span>T6</span><span>T7</span><span>CN</span>
          </div>
        </div>
        <output id="berth2dMoment" for="berth2dRange"></output>
      </div>
      <div class="berth-plan-scroller">
        <svg id="berth2dSvg" role="img" aria-label="Sơ đồ nhìn từ trên xuống của cầu bến và tàu dự kiến hiện diện"></svg>
      </div>
      <div class="berth-plan-footer">
        <p id="berth2dSummary" role="status" aria-live="polite"></p>
        <div class="legend berth-plan-legend" aria-label="Chú giải sơ đồ cầu bến">
          <span><i class="sw berth-ship-normal"></i> Bình thường</span>
          <span><i class="sw berth-ship-warning"></i> Kiểm tra tiếp nhận</span>
          <span><i class="sw berth-ship-conflict"></i> Xung đột tại thời điểm chọn</span>
          <span><i class="sw berth-ship-moving"></i> Đang cập / rời</span>
        </div>
      </div>
    </div>

    <div class="panel kpis" id="kpis"></div>

    <div class="split content-split">
      <div class="panel" id="callListPanel">
        <div class="panel-head"><h2>Danh sách lượt tàu</h2><button type="button" class="btn btn-primary" id="addCall" disabled>Thêm lượt tàu</button></div>
        <p id="callListMsg" class="note" role="status" aria-live="polite"></p>
        <div class="tablewrap"><table id="callTable">
          <thead><tr>
            <th>Tàu</th><th>Tuyến</th><th>Vị trí (m)</th><th>Cửa sổ</th><th>Bắt đầu kế hoạch</th><th>Lệch</th><th>Trạng thái</th><th>Thao tác</th>
          </tr></thead>
          <tbody></tbody>
        </table></div>
        <div class="note">Bấm vào một dòng để xem chi tiết và làm nổi bật trên biểu đồ.</div>
      </div>
      <div class="panel detail" id="detail"><div class="empty">Chưa chọn lượt tàu nào.</div></div>
    </div>

          <%- include('../partials/berth-inputs') %>
        </div>
      </main>
    </div>
  </div>

  <%- include('../partials/berth-call-dialog') %>

  <script src="/js/berth-domain.js" defer></script>
  <script src="/js/berth-window.js" defer></script>
</body>
</html>
