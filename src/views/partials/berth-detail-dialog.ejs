<dialog id="detailDialog" class="detail-dialog" aria-labelledby="detailDialogTitle">
  <div class="detail-dialog-head">
    <div>
      <p>Thông tin lượt tàu</p>
      <h2 id="detailDialogTitle">Chi tiết lượt tàu</h2>
    </div>
    <button class="btn detail-dialog-close" id="closeDetail" type="button" aria-label="Đóng thông tin lượt tàu">Đóng</button>
  </div>
  <div class="detail-dialog-body" id="detail" role="region" aria-label="Nội dung chi tiết lượt tàu" tabindex="0"></div>
  <div class="detail-dialog-actions">
    <button class="btn" id="closeDetailFooter" type="button">Đóng</button>
  </div>
</dialog>
